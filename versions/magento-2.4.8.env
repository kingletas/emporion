# The Magento 2.4.8 line: the versions a store pinned to 2.4.8 runs. A site
# chooses it with MAGENTO_LINE=2.4.8 in its own env file, and it must then be an
# exclusive site: Magento 2.4.8's database version check lists no MariaDB 12,
# which is what the shared data tier runs on the default line.
#
# The cluster reads the same list from k8s/components/magento-2.4.8, which
# scripts/deploy.sh adds for a site on this line. `make lint` fails when the two
# disagree.
#
# Format is `KEY=value`, unquoted. The value is the whole image tag.

# Build arguments for build/Dockerfile.
PHP_VERSION=8.4
COMPOSER_VERSION=2.9.3

# Image tags.
MARIADB_VERSION=11.4
VALKEY_VERSION=8.0-alpine
NGINX_VERSION=1.28.0
VARNISH_VERSION=7.5.0
OPENSEARCH_VERSION=3
RABBITMQ_VERSION=4.3-management-alpine
MAILHOG_VERSION=v1.0.1
