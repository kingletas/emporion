# The Magento 2.4.9 line: every version a store on this line runs, taken from
# Adobe's self-hosted system requirements for 2.4.9, except Varnish: 9.1 is the
# default here and 8.0.2, Adobe's version, is a per-store choice through
# VARNISH_VERSION in a store's own env file. This is the default line, named by
# MAGENTO_LINE in k8s/base/config/env/common.env.
#
# One list per line. scripts/lib.sh exports these for Compose and the image
# build; the `images:` in k8s/base/kustomization.yaml, the `${NAME:-default}`
# fallbacks in the Compose files and the ARG defaults in build/Dockerfile repeat
# them because neither kustomize nor Docker can read this file, and `make lint`
# fails when any of those copies disagrees with it.
#
# Format is `KEY=value`, unquoted, the same as every other env file here. The
# value is the whole image tag, so a variant such as `-alpine` belongs in it.

# Build arguments for build/Dockerfile.
PHP_VERSION=8.5
COMPOSER_VERSION=2.10.3

# Image tags.
MARIADB_VERSION=12.3
VALKEY_VERSION=9.0-alpine
NGINX_VERSION=1.30.5
VARNISH_VERSION=9.1.0
OPENSEARCH_VERSION=3
RABBITMQ_VERSION=4.3-management-alpine
MAILHOG_VERSION=v1.0.1
