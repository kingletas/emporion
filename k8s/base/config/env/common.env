# Configuration EVERY site shares, and the ONE place any of these values is
# written. The handful of values that must differ per site are not here -- they
# are in config/env/sites/<slug>.env, one small file each, and both runtimes
# read the two files as a layer: common first, then the site.
#
# THE SPLIT IS BY WHETHER TWO SITES CAN SHARE THE VALUE, not by how interesting
# it is. A second store on this machine reaches the same MariaDB, the same
# OpenSearch and the same Valkey, so its database name, its cache prefix, its
# search index prefix, its queue vhost and its Redis database numbers must all
# differ or the two stores quietly read each other's data. Everything in this
# file is either a service address, a behaviour, or a list -- none of which a
# second site has any reason to disagree with.
#
# Both runtimes read this exact file:
#
#   kind cluster   k8s/base/kustomization.yaml, as a configMapGenerator `envs:`
#                  entry. The generator still hashes the content into the
#                  ConfigMap name, so editing this file rolls the pods that
#                  consume it -- an edited ConfigMap applied by hand changes
#                  nothing until something restarts, and "I changed the config
#                  and nothing happened" is the most expensive hour there is.
#
#   Compose        docker-compose.yaml, as the first of two `env_file:` entries
#                  on every application service. Compose applies them in order
#                  and the later one wins, which is the same layering.
#
# ADDING A KEY HERE IS SAFE. Adding one that a second site would need to
# differ on is not, and nothing mechanical catches it -- ask whether two
# stores sharing this machine could both hold the value before writing it.
#
# IT LIVES UNDER k8s/base/ FOR ONE REASON, and it is not tidiness: kustomize
# refuses to read a file outside the kustomization root --
#
#   security; file '.../common.env' is not in or below '.../k8s/base'
#
# -- and the alternative is passing --load-restrictor LoadRestrictionsNone to
# every kustomize invocation in the repository, which disables that check for
# everything else too. Compose can read any path, so Compose is the one that
# reaches across. Do not "tidy" this up to the repository root.
#
# Two copies of these values would drift, and the drift would be invisible:
# both runtimes would start, and only one would be right. Nothing here is a
# credential -- those are generated into secrets/ by scripts/secrets.sh and
# never committed.
#
# EDITING THIS FILE IS A DEPLOY, NOT A RESTART. Magento hashes the `system`
# section of env.php and refuses to serve when it changes without being
# re-imported -- every storefront request returns 500 with
#
#   The configuration file has changed. Run the "app:config:import" or the
#   "setup:upgrade" command to synchronize the configuration.
#
# So after changing anything here: rebuild if the entrypoint changed, then run
# `make compose-install` or `make deploy`. Both end in app:config:import.
# It fails loudly, which is the good case -- but it fails on the storefront
# rather than at the point of the edit.
#
# Format is `KEY=value`, no quoting and no interpolation. Kustomize's env
# parser accepts nothing else, and a quoted value arrives in the container
# with its quotes still attached.

# --- service addresses ------------------------------------------------------
# These are Kubernetes Service names AND Compose service names, deliberately
# identical. That identity is what lets the Varnish VCL, the nginx template and
# magento-entrypoint be shared byte-for-byte between the two runtimes; a name
# that differs here means two of everything downstream.
DB_HOST=db
DB_PORT=3306
REDIS_CACHE_HOST=valkey-cache
REDIS_SESSION_HOST=valkey-session
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=magento
VARNISH_HOST=varnish
VARNISH_PORT=80

# --- application ------------------------------------------------------------
MAGENTO_MODE=production
MAGENTO_ADMIN_URI=admin
# Magento's cron is a CronJob in the cluster and its own service under Compose,
# never an in-process runner inside a web pod.
MAGENTO_CRON_RUN=false
# 1 = a consumer blocks on an empty queue; 0 = it exits immediately. Every
# consumer here is a long-running workload with a restart policy, so 0 means an
# idle store restart-loops six PHP bootstraps every few seconds, forever.
MAGENTO_CONSUMERS_WAIT=1
# 2 = Varnish, 1 = Magento's built-in cache. A fresh install defaults to 1, and
# the symptom is silent: the storefront returns `Cache-Control: no-store`,
# Varnish caches nothing, and every request is a MISS with no error anywhere.
MAGENTO_FPC_APPLICATION=2
MAGENTO_FPC_TTL=86400

# --- cache types ------------------------------------------------------------
# EVERY CACHE TYPE MAGENTO SHOULD HAVE ENABLED, and it has to be spelled out.
#
# `cache_types` in env.php is authoritative and it fails closed: a type that is
# not listed there is DISABLED, and so is every type when the key is absent
# entirely. A fresh install with a generated env.php therefore runs with all 18
# caches off -- including full_page, which is why the storefront returns
# `Cache-Control: no-store` and Varnish caches nothing.
#
# Nothing reports this. `cache:status` shows a column of zeroes that reads like
# a state somebody chose.
#
# It lives here rather than in the entrypoint because it is version-dependent:
# modules add cache types. magento-install compares this list against what
# Magento actually reports and fails when they disagree, which is the only
# thing that will catch the next module that adds one.
MAGENTO_CACHE_TYPES=admin_ui_sdk block_html collections compiled_config config config_integration config_integration_api config_webservice customer_notification db_ddl eav full_page graphql_query_resolver_result layout reflection target_rule translate webhooks_response
# Stable across every container on purpose. Magento mixes install_date into
# cache identifiers; a per-container value means two replicas never share a
# cache entry and the storefront looks intermittently uncached.
MAGENTO_INSTALL_DATE=Thu, 01 Jan 2026 00:00:00 +0000
DATA_CONVERTER_BATCH_SIZE=1000000

# --- install ----------------------------------------------------------------
# Read by magento-install on a first run only. The admin PASSWORD is not here;
# it is generated into secrets/ like every other credential.
MAGENTO_ADMIN_USER=admin
MAGENTO_ADMIN_EMAIL=admin@example.com
MAGENTO_ADMIN_FIRSTNAME=Store
MAGENTO_ADMIN_LASTNAME=Administrator
MAGENTO_LANGUAGE=en_US
MAGENTO_CURRENCY=USD
MAGENTO_TIMEZONE=America/Chicago

# --- consumers --------------------------------------------------------------
# THIS LIST AND k8s/base/jobs/consumers.yaml MUST AGREE, and under Compose it
# must agree with the consumer services in docker-compose.yaml.
#
# A queue named here with no worker is never consumed; a worker for a queue not
# named here runs a consumer Magento does not believe exists. Neither produces
# an error anywhere. `make verify-consumers` is the check, and it exists
# because no runtime can make this one for us.
MAGENTO_CONSUMERS=async.operations.all product_action_attribute.update inventory.reservations.update inventory.reservations.cleanup media.gallery.synchronization codegeneratorProcessor
