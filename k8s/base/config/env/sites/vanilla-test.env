# vanilla.test — the per-site half of the configuration.
#
# ONE FILE PER SITE, and it holds only what a second store on this machine
# cannot share. Everything else is in ../common.env, which both this file and
# every other site's layer on top of. Both runtimes read the pair in that
# order: Compose as two `env_file:` entries, kustomize as two `envs:` entries,
# and in both the later file wins.
#
# WHY EACH KEY IS HERE. Sites share one MariaDB, one OpenSearch, one Valkey
# pair and one RabbitMQ in the default (shared) mode, so every namespace below
# is what keeps two stores out of each other's data. The failures they prevent
# do not look like configuration -- a shared index prefix looks like a
# catalogue that has other people's products in it, and a shared queue vhost
# looks like a message that vanished.
#
# EDITING THIS FILE IS A DEPLOY, NOT A RESTART, exactly as for common.env:
# Magento hashes the `system` section of env.php and refuses to serve until
# app:config:import runs. Finish with `make compose-install SITE=vanilla.test`.
#
# EVERY OTHER FILE IN THIS DIRECTORY IS GITIGNORED, and this one is not for a
# mechanical reason rather than a sentimental one: k8s/base/kustomization.yaml
# names this exact path in its configMapGenerator, so a clone without it cannot
# render either overlay and `make lint` fails on a checkout that has done
# nothing wrong. It is also the worked example the generated ones are read
# against, which is why it carries the reasoning above.
#
# A site created by `make new-site` is machine state -- creating and destroying
# a scratch store should not be two commits. Format is `KEY=value`, unquoted;
# kustomize's env parser accepts nothing else.

# --- namespaces, one per site -----------------------------------------------
DB_NAME=vanilla
DB_USER=vanilla
MAGENTO_BASE_URL=https://vanilla.test/
# Namespaces every cache key in the shared Valkey. Trailing underscore by
# convention so the prefix is visible in `KEYS *` output.
MAGENTO_CACHE_PREFIX=vanilla_
# The OpenSearch index prefix. `magento2` is Magento's own default and this
# site keeps it because its indices already exist under that name -- a new site
# gets its slug instead. Two stores sharing a prefix write into one index and
# each sees the other's products with no error anywhere.
OPENSEARCH_INDEX_PREFIX=magento2
# The RabbitMQ vhost. Magento's queue names are fixed strings, identical in
# every store, so two sites on one vhost share every queue -- a message
# published by one is consumed by the other, and the only symptom is work that
# silently never happened. `/` is the default vhost and this site keeps it.
RABBITMQ_VIRTUALHOST=/
# Valkey database numbers. The cache prefix already separates the keys; these
# separate the keyspaces, so `redis-cli -n N flushdb` and eviction pressure
# stay per site. Redis offers 16 by default, which bounds a shared Valkey at
# eight sites -- scripts/site.sh allocates them and refuses when they run out.
REDIS_CACHE_DB=0
REDIS_PAGE_CACHE_DB=1
REDIS_SESSION_DB=0

# --- read by the tooling, not by Magento ------------------------------------
# Magento ignores unknown keys, so these ride in the same file rather than in a
# second one that could go missing. `make sites` prints them.
SITE_HOST=vanilla.test
# shared = attaches to the shared data tier. exclusive = its own.
SITE_MODE=shared
# The snapshot this site was seeded from, or `none` for an empty install.
SITE_SEED=none
# Empty means the shared image and the shared tree. Set either to diverge.
SITE_IMAGE_TAG=
SITE_MAGENTO_SRC=
# Where the crypt key came from. `own` means generated for this site.
SITE_CRYPT_ORIGIN=own

# Where the application code comes from: image | mounted.
# See scripts/compose-source.sh.
SITE_SOURCE=mounted
