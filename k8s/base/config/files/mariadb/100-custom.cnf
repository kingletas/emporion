# MariaDB tuning for a local container, read by BOTH runtimes -- mounted from a
# ConfigMap by the StatefulSet and bind-mounted by the Compose service. One
# file, so the two can never be tuned differently by accident.
#
# Sized for a working set on a laptop, not for a dataset. The host runs an
# editor, a browser and the rest of a working day alongside this, and a buffer
# pool large enough to matter is a buffer pool the host cannot spare.
#
# tmp_table_size and max_heap_table_size are PER in-memory temporary table, not
# a total. A single report query at a multi-gigabyte setting can exhaust the
# container on its own, which is why they stay small here rather than being
# raised until something stops spilling to disk.
[mysqld]
innodb_buffer_pool_size = 512M
innodb_log_file_size = 128M
# flush_log_at_trx_commit = 2 trades durability for write throughput: a crash
# of the HOST can lose up to a second of transactions. Correct for a store that
# is installed from empty in minutes, and never correct in production.
innodb_flush_log_at_trx_commit = 2
innodb_flush_method = O_DIRECT
key_buffer_size = 16M
tmp_table_size = 32M
max_heap_table_size = 32M
max_connections = 200
table_open_cache = 2000
sql_mode = "ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION"
skip_name_resolve = 1
